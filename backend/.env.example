# ---- Bolo Yojana backend configuration ----
# Where the shared knowledge base lives (schemes.json, dialectGlossary.json, intents.json …)
DATA_DIR=../frontend/src/data
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# LLM (optional). Without a key, answers are composed directly from retrieved verified chunks.
# auto = Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set
LLM_PROVIDER=auto
# Google Gemini — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Anthropic Claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Vector store: auto | faiss | chroma | tfidf   (auto = best installed)
VECTOR_STORE=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Bhashini (ULCA) — https://bhashini.gov.in/ulca  → enables ASR, NMT and TTS adapters
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Translation provider order: auto | bhashini | indictrans2 | llm
TRANSLATE_PROVIDER=auto
# Optional regex for allowed origins (useful when the host adds a random suffix to your URL)
CORS_ORIGIN_REGEX=
