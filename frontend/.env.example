# ---- Bolo Yojana frontend configuration ----
# Leave everything empty for the fully offline, zero-key prototype.

# FastAPI backend (RAG + LLM + Bhashini / AI4Bharat adapters). Empty = frontend-only mode.
VITE_API_URL=
# Speech-to-text: webspeech (browser) | backend (IndicWhisper / IndicConformer / Bhashini ASR via /stt)
VITE_STT_PROVIDER=webspeech
# Text-to-speech: browser (SpeechSynthesis) | backend (Bhashini / Indic-TTS via /tts)
VITE_TTS_PROVIDER=browser
# Translation: offline (phrasebook) | backend (IndicTrans2 / Bhashini / LLM via /translate)
VITE_TRANSLATE_PROVIDER=offline

# Optional: self-host Tesseract.js assets for fully offline OCR (copy from node_modules/tesseract.js/dist
# and tesseract.js-core, plus hin/eng .traineddata.gz into /public/tesseract/). Default = jsDelivr CDN.
VITE_TESSERACT_WORKER_PATH=
VITE_TESSERACT_CORE_PATH=
VITE_TESSERACT_LANG_PATH=
